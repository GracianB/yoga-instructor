{
  "name": "yoga-instructor",
  "version": "5.0.0",
  "private": true,
  "description": "Gracián Baena — Yoga Instructor portfolio",
  "scripts": {
    "check": "node tools/yoga-audit.mjs",
    "syntax": "node tools/syntax.mjs",
    "test:e2e": "node --test tests/instructor-flow.test.mjs tests/session-clock.test.mjs tests/phase-clock.test.mjs tests/quality-100.test.mjs tests/quality-200.test.mjs",
    "test:quality100": "node --test tests/quality-100.test.mjs",
    "test:quality200": "node --test tests/quality-200.test.mjs",
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "quality": "npm run syntax && npm run check && npm test && npm run audit:release",
    "build": "node tools/build.mjs",
    "audit:release": "node tools/release-audit.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "postcss": "^8.5.6"
  }
}
